# ---------------------------------------------------------------------------
# Odoo 18 - Environment configuration
# Copy this file to .env and adjust values before running docker compose.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_this_password

# Odoo
ODOO_VERSION=18.0
HOST_HTTP_PORT=8069
HOST_LONGPOLLING_PORT=8072
